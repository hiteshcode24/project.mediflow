# ==========================================
# MediFlow Environment Configuration
# ==========================================

# Database Connection (SQLite local out-of-the-box or PostgreSQL)
# Local SQLite default:
DATABASE_URL="file:./dev.db"
# PostgreSQL Alternative (e.g., Supabase / Neon / Local Docker):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mediflow?schema=public"

# Authentication & Session Security
JWT_SECRET="mediflow_production_grade_jwt_secret_key_987654321_secure"
JWT_EXPIRES_IN="7d"

# Base Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Integration (Optional Google Gemini API Key)
# If left empty, MediFlow operates in robust built-in Medical Terminology NLP Mode
GEMINI_API_KEY=""

# Upload Directory for Medical Records / Reports
UPLOAD_DIR="./uploads"
